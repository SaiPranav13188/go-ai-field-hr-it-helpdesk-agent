# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API (your Vercel URL in production)
FRONTEND_ORIGINS=http://localhost:3000

# Signing secrets (generate with: python -c "import secrets;print(secrets.token_urlsafe(48))")
SESSION_SECRET=replace_me
MCP_IDENTITY_SECRET=replace_me

# Generation model (Google Gemini)
GENERATION_PROVIDER=gemini
GENERATION_MODEL=gemini-3.5-flash-lite
CLASSIFIER_MODEL=gemini-3.1-flash-lite
GENERATION_FALLBACK_MODEL=gemini-3.1-flash-lite
GENERATION_API_KEY=replace_me

# Retrieval models. MODEL_BACKEND: auto | local | hf_api | remote
#  local  = run BGE-M3 + reranker in-process (needs `uv sync --extra local`)
#  hf_api = same BAAI models through the Hugging Face Inference API (used on Render)
MODEL_BACKEND=auto
HF_TOKEN=
BGE_M3_MODEL=BAAI/bge-m3
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# MODEL_BACKEND=remote → self-hosted model service (model_service/, e.g. a free Hugging Face Space)
MODEL_SERVICE_URL=
MODEL_SERVICE_KEY=

# Qdrant (leave QDRANT_URL empty to use the embedded on-disk store in ./data/qdrant_local)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=hr_it_policies

# PostgreSQL — read ONLY by the MCP server process, as the least-privilege role.
# Supabase session pooler: host aws-0-<region>.pooler.supabase.com, user helpdesk_readonly.<project-ref>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=helpdesk_readonly
POSTGRES_PASSWORD=replace_me
POSTGRES_SSLMODE=require
